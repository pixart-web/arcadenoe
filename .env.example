# Endereço canónico do site no lançamento (usado em canonical, hreflang, sitemap e JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.vet-arcadenoe.com

# "true" mantém a demonstração: noindex, robots.txt fechado e etiqueta «Proposta de redesign — PIXART».
NEXT_PUBLIC_DEMO=true

# Modo do formulário de pedido de consulta:
#   demo -> não envia nada; mostra um resumo local (predefinição)
#   api  -> envia por POST JSON para NEXT_PUBLIC_BOOKING_ENDPOINT
#           sem endpoint configurado, mostra indisponibilidade e alternativa por telefone
NEXT_PUBLIC_BOOKING_MODE=demo
NEXT_PUBLIC_BOOKING_ENDPOINT=
